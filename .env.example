# Copy to .env (gitignored) and fill in. Loaded automatically by src/config.py.

# SEC EDGAR fair-access policy requires a descriptive User-Agent naming you + a
# contact email. Format: "project-name your-email@example.com"
EDGAR_USER_AGENT=institutional-breadth-13f your-email@example.com

# Optional. Free key from https://www.openfigi.com/api — raises the CUSIP mapping
# limit from 10 jobs/request (25/min) to 100 jobs/request (250/min), cutting the
# full-universe mapping from ~5 hours to ~3 minutes.
OPENFIGI_API_KEY=
